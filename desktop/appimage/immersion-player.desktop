[Desktop Entry]
Type=Application
Name=Immersion Player
Comment=Japanese video player with a built-in dictionary
Exec=immersion-player %f
Icon=immersion-player
Categories=AudioVideo;Video;Education;
MimeType=video/x-matroska;video/mp4;video/webm;video/x-msvideo;video/quicktime;
Terminal=false
# the window's class, so docks put it under this launcher (setLinuxWindowClass in Main.kt)
StartupWMClass=immersion-player-Immersion_Player
